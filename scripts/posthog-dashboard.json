{
  "timezone": "America/Phoenix",
  "dashboard": {
    "name": "Daily Split · daily users and shares",
    "description": "Daily browser activity, daily game play, native share handoffs, copies, unique sharers, friend arrivals and next-day retention. Days use America/Phoenix; challenge_date and local_play_date track the player local day separately. Users are browsers/devices. Practice, archive and preview activity are excluded from gameplay/share metrics. Tracking starts at deployment.",
    "pinned": true,
    "tags": [
      "dailysplit:dashboard-v1"
    ]
  },
  "insights": [
    {
      "name": "Daily Split · browsers, players, finishers",
      "description": "Unique browsers opening the game; unique browsers starting a daily sip; unique browsers saving their first eligible daily result. Reporting days use the PostHog project timezone America/Phoenix.",
