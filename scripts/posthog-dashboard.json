    {
      "name": "Daily Split · share handoffs and copies",
      "description": "Event totals, not unique people. Native handoffs show successful Web Share handoffs; copies show successful clipboard writes. Neither proves a message was delivered. Includes only eligible daily results.",
      "tags": [
        "dailysplit:share-actions"
      ],
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "dateRange": {
            "date_from": "-30d",
            "date_to": null
          },
          "interval": "day",
          "series": [
            {
              "kind": "EventsNode",
              "event": "result_shared",
              "name": "result_shared",
              "custom_name": "Native handoffs",
              "math": "total",
              "properties": [
                {
                  "key": "attempt_kind",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "daily"
                  ]
                },
                {
                  "key": "counts",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    true
                  ]
                }
              ]
            },
            {
              "kind": "EventsNode",
              "event": "result_copied",
              "name": "result_copied",
              "custom_name": "Successful copies",
              "math": "total",
              "properties": [
                {
                  "key": "attempt_kind",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "daily"
                  ]
                },
                {
                  "key": "counts",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    true
                  ]
                }
              ]
            }
          ],
          "trendsFilter": {
            "display": "ActionsLineGraph",
            "showLegend": true
          },
          "version": 2
        }
      }
    },
    {
      "name": "Daily Split · unique sharers and share rate",
      "description": "Each browser counts once per Phoenix reporting day across native handoffs and clipboard copies combined. Share rate = unique daily sharers / daily finishers; blank when no finishers. Shares can concern a saved result from an earlier reporting day, so this is a same-day activity ratio, not a cohort conversion rate. Browser-local challenge_date and local_play_date remain available as event filters.",
      "tags": [
        "dailysplit:share-rate"
      ],
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT day, unique_sharers, daily_finishers,\n    1.0 * unique_sharers / nullIf(daily_finishers, 0) AS share_rate\nFROM (\n    SELECT toDate(toTimeZone(timestamp, 'America/Phoenix')) AS day,\n        uniqExactIf(distinct_id, event IN ('result_shared', 'result_copied')) AS unique_sharers,\n        uniqExactIf(distinct_id, event = 'sip_completed') AS daily_finishers\n    FROM events\n    WHERE event IN ('result_shared', 'result_copied', 'sip_completed')\n        AND properties.attempt_kind = 'daily'\n        AND properties.counts = true\n        AND {filters}\n    GROUP BY day\n)\nORDER BY day DESC\nLIMIT 1000",
          "filters": {
            "dateRange": {
              "date_from": "-30d",
              "date_to": null
            }
          }
        },
        "display": "ActionsTable",
        "tableSettings": {
          "columns": [
            {
              "column": "day"
            },
            {
              "column": "unique_sharers"
            },
            {
              "column": "daily_finishers"
            },
            {
              "column": "share_rate",
              "settings": {
                "formatting": {
                  "style": "percent",
                  "decimalPlaces": 1
                }
              }
            }
          ]
        }
      }
    },
