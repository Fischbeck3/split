              "event": "game_opened",
              "name": "game_opened",
              "custom_name": "Browsers",
              "math": "dau",
              "properties": []
            },
            {
              "kind": "EventsNode",
              "event": "sip_started",
              "name": "sip_started",
              "custom_name": "Daily players",
              "math": "dau",
              "properties": [
                {
                  "key": "attempt_kind",
