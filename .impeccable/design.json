  "components": [
    {
      "name": "Split wordmark",
      "kind": "custom",
      "refersTo": "wordmark",
      "description": "The incumbent identity across every place.",
      "html": "<a class=\"ds-wordmark\" href=\"#\">Split<span class=\"ds-dot\">.</span></a>",
      "css": ".ds-wordmark{font:900 36px/1 Fraunces,Georgia,serif;letter-spacing:-.035em;color:var(--fg,#eee7d6);text-decoration:none}.ds-dot{color:var(--accent,#d9b874)}.ds-wordmark:hover{text-decoration:underline;text-underline-offset:5px}.ds-wordmark:focus-visible{outline:2px solid var(--fg,#eee7d6);outline-offset:5px}"
    },
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Start the primary hold-to-sip interaction or share the result.",
      "html": "<button type=\"button\" class=\"ds-primary\">Take today’s sip <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button>",
      "css": ".ds-primary{display:flex;align-items:center;justify-content:center;gap:12px;min-height:54px;padding:12px 20px;border:0;border-radius:8px;background:var(--accent,#d9b874);color:var(--accent-fg,#17221b);font-family:Karla,'Helvetica Neue',Arial,sans-serif;font-size:17px;font-weight:700;line-height:1.3;cursor:pointer}.ds-primary:hover{filter:brightness(1.06)}.ds-primary:disabled{opacity:.5;cursor:wait}.ds-primary:focus-visible{outline:2px solid var(--fg,#eee7d6);outline-offset:5px}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:filter 160ms ease-out}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Optional phone tilt, practice, or recalibration.",
      "html": "<button type=\"button\" class=\"ds-text\">Use phone tilt</button>",
      "css": ".ds-text{min-height:38px;border:0;background:none;color:var(--fg,#eee7d6);font-family:Karla,'Helvetica Neue',Arial,sans-serif;font-size:14px;font-weight:700;padding:6px 8px;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px;cursor:pointer}.ds-text:hover{text-decoration-thickness:2px}.ds-text:focus-visible{outline:2px solid var(--fg,#eee7d6);outline-offset:5px}"
    },
    {
      "name": "Outlined action",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Copy the plain-text share.",
      "html": "<button type=\"button\" class=\"ds-outline\">Copy text</button>",
      "css": ".ds-outline{min-height:54px;border:1px solid var(--line,#3c4a40);border-radius:8px;background:transparent;color:var(--fg,#eee7d6);padding:8px 14px;font-family:Karla,'Helvetica Neue',Arial,sans-serif;font-weight:700;font-size:14px;cursor:pointer}.ds-outline:hover{background:var(--line,#3c4a40)}.ds-outline:focus-visible{outline:2px solid var(--fg,#eee7d6);outline-offset:5px}@media(prefers-reduced-motion:no-preference){.ds-outline{transition:background 160ms ease-out}}"
    },
    {
