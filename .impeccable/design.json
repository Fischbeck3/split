      "css": ".ds-drink{width:100%;min-height:64px;background:var(--accent,#d9b874);color:var(--accent-fg,#17221b);border:0;border-radius:8px;font-family:Karla,'Helvetica Neue',Arial,sans-serif;font-size:18px;font-weight:700;touch-action:none;user-select:none;cursor:pointer}.ds-drink:active{filter:brightness(.91)}.ds-drink:focus-visible{outline:2px solid var(--fg,#eee7d6);outline-offset:5px}"
    },
    {
