                    "daily"
                  ]
                }
              ]
            },
            {
              "kind": "EventsNode",
              "event": "sip_completed",
              "name": "sip_completed",
              "custom_name": "Daily finishers",
              "math": "dau",
              "properties": [
                {
                  "key": "attempt_kind",
                  "type": "event",
                  "operator": "exact",
                  "value": [
                    "daily"
                  ]
